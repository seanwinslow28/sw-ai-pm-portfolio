---
/**
 * <ShippedNow /> — live install-count block for SHIPPED case studies.
 *
 * Reads /api/shipped-stats-<slug>.json at BUILD time (no client fetch).
 * Daily Driver writes this file nightly in Phase 4; v1 hand-seeds it
 * (see public/api/shipped-stats-intent-engineering-mcp.json).
 *
 * Source: case-study-spec-v1.md §12.2 + §15.
 */
import fs from "node:fs/promises";
import path from "node:path";
import { isFresh } from "~/lib/dateline";

interface Props {
  slug: string;
  shippedStatsEndpoint: string;   // e.g. /api/shipped-stats-intent-engineering-mcp.json
}

const { slug, shippedStatsEndpoint } = Astro.props;

interface StatsRow { label: string; value: string; unit?: string }
interface Stats {
  updated_at?: string;
  items?: StatsRow[];
  // When true, the block reports durable ship facts (not live metrics): no
  // LIVE pulse, no "by daily driver" attribution, no freshness gate.
  static?: boolean;
}

async function readLocalJson(endpoint: string): Promise<Stats | null> {
  // endpoint = "/api/foo.json" → public/api/foo.json
  const rel = endpoint.replace(/^\//, "");
  try {
    const filePath = path.join(process.cwd(), "public", rel);
    const raw = await fs.readFile(filePath, "utf8");
    return JSON.parse(raw);
  } catch {
    return null;
  }
}

const stats = await readLocalJson(shippedStatsEndpoint);

// "real and dated" gate: the pulsing LIVE badge may only assert liveness when
// the fleet JSON was written within the freshness window. A stale file (fleet
// missed a morning, or the site was redeployed without a fresh run) still
// shows its real numbers + real timestamp, but as a static "LATEST" read with
// no pulse — so the badge never overstates how live the data is. Mirrors the
// hero dateline + about-teaser gating (see src/lib/dateline.ts).
const isStatic = stats?.static === true;
const updatedIso = stats?.updated_at ? stats.updated_at.slice(0, 10) : null;
// Static cards never assert liveness, so the freshness gate is skipped for them.
const fresh = !isStatic && updatedIso ? isFresh(updatedIso) : false;

const fallbackText = stats === null
  ? "stats refresh nightly"
  : null;

const updatedPretty = stats?.updated_at
  ? new Date(stats.updated_at).toLocaleString("en-US", {
      year: "numeric", month: "2-digit", day: "2-digit",
      hour: "2-digit", minute: "2-digit", hour12: false,
      // Boston time, not build-machine time: Vercel's UTC build was
      // rendering the fleet's 08:30 ET write as "12:30".
      timeZone: "America/New_York",
    })
  : null;

// Static cards show a plain "shipped <Month Year>" stamp instead of a
// daily-driver freshness timestamp.
const shippedPretty = isStatic && stats?.updated_at
  ? new Date(stats.updated_at).toLocaleString("en-US", {
      year: "numeric", month: "long", timeZone: "America/New_York",
    })
  : null;
---

<aside class="shipped-now" aria-labelledby={`shipped-now-${slug}`}>
  <p id={`shipped-now-${slug}`} class="live-label" data-fresh={fresh ? "true" : "false"}>
    {fresh && <span class="live-dot" aria-hidden="true">●</span>}
    {isStatic ? "SHIPPED" : fresh ? "LIVE" : "LATEST"}
  </p>
  {fallbackText && <p class="fallback">{fallbackText}</p>}
  {stats?.items && (
    <ul class="stats-list">
      {stats.items.map((row) => (
        <li class="stats-row">
          <span class="stat-value">{row.value}</span>
          <span class="stat-unit">{row.unit ?? ""}</span>
          <span class="stat-label">{row.label}</span>
        </li>
      ))}
    </ul>
  )}
  {isStatic
    ? (shippedPretty && <p class="updated-at">shipped {shippedPretty}</p>)
    : (updatedPretty && <p class="updated-at">updated {updatedPretty} by daily driver</p>)
  }
</aside>

<style>
  .shipped-now {
    max-width: 720px;
    margin: 32px auto 0;
    padding: 16px 24px;
    border: 0.5px solid var(--border-paper);
    border-radius: 2px;
    background-color: rgba(15, 110, 86, 0.04);
    font-family: var(--font-mono);
  }
  .live-label {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.8px;
    color: var(--success-teal, #0F6E56);
    text-transform: uppercase;
    margin: 0 0 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  /* Stale read: drop the live-green so "LATEST" reads as an archival stamp,
     not a live signal. The pulsing dot is omitted in markup when not fresh. */
  .live-label[data-fresh="false"] {
    color: var(--ink-secondary);
  }
  .live-dot {
    color: var(--success-teal, #0F6E56);
    font-size: 10px;
    animation: live-pulse 2s ease-in-out infinite;
  }
  @keyframes live-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
  .fallback {
    font-size: 12px;
    font-weight: 400;
    color: var(--ink-secondary);
    margin: 0;
  }
  .stats-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
  }
  .stats-row {
    font-size: 13px;
    font-weight: 400;
    color: var(--ink);
    letter-spacing: 0.4px;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }
  .stat-value { font-weight: 500; color: var(--teal); }
  .stat-unit { color: var(--ink-secondary); font-size: 11px; }
  .stat-label { color: var(--ink-secondary); }
  .updated-at {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.6px;
    color: var(--ink-secondary);
    margin: 12px 0 0;
    padding-top: 12px;
    border-top: 0.5px dashed var(--border-paper);
  }

  @media (max-width: 767px) {
    .shipped-now { padding: 12px 16px; }
    .stats-list { gap: 8px 16px; }
    .stats-row { font-size: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .live-dot { animation: none; }
  }
</style>
