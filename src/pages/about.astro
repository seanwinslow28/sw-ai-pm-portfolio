---
/**
 * /about/ — Sean's human-self surface.
 *
 * v3 anatomy (2026-08-08, Sean's preview-review round 2), top to bottom:
 *   1. (BaseLayout dateline / nav / etc. — chrome is on)
 *   2. (MDX body) the opening spread — the L13 paragraph (byte-locked)
 *      beside the character; the lead title is retired (the "Raised by..."
 *      line lives on in the meta description)
 *   3. (MDX body) NowPulse + machinery line
 *   4. (MDX body) Biesty Cutaway — plate + six pairing-grammar cards
 *   5. (MDX body) ProofPoints (+ resume; heading centered)
 *   6. (MDX body) PullQuote — byte-lockstep with the home teaser hook
 *   (RecruiterCallout removed 2026-08-08 at Sean's direction — an applicant's
 *   site needs no availability disclaimer; supersedes the L14b restore.)
 *
 * The old 10-band anatomy (Beats / B-2 / CartoonCanon / B-4) is
 * superseded — recorded in CHANGELOG under about-spec; the six life
 * beats are banked in the anima brief lane as film material.
 *
 * The page renders with FULL site chrome (nav + footer) — NOT
 * noChrome={true} (that's home-only per BaseLayout convention).
 *
 * Source: about-spec-v1.md §2 (as-built baseline) + sidecar L7-L14.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import "~/styles/about.css";

const aboutEntries = await getCollection("about");
const aboutEntry = aboutEntries[0];
if (!aboutEntry) {
  throw new Error("src/content/about/index.mdx missing — Phase 3d Task 8.2 should have shipped it");
}

const { Content, headings: _headings } = await aboutEntry.render();
const fm = aboutEntry.data;

const pageDescription = fm.description;
---

<BaseLayout title={fm.title} description={pageDescription} ogImage="/og-default.png">
  <main id="main" class="about-page page-sheet">
    <!-- The visible lead title was retired 2026-08-08 (Sean's call); the page
         still needs its one h1 for heading order, so it rides screen-reader
         only. -->
    <h1 class="sr-only">About Sean Winslow</h1>

    <div class="about-page__mdx">
      <Content frontmatter={fm} />
    </div>
  </main>
</BaseLayout>
