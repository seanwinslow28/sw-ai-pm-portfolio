---
/**
 * <ProofPoints /> — B-5 four-link block.
 *
 * Labeled rows: uppercase mono channel + human display text, one per
 * line (2026-06-10 audit lever 4 — the raw `sean-winslow-204390a5` slug
 * read as an unfinished surface right before the closing pull quote;
 * spec deviation from §13's "no descriptions" logged in CHANGELOG).
 * The em dash in the rows is wire-service register (audit D-2 precedent:
 * mono-label em dashes inherit from newspaper typography).
 * The arrow prefix is rendered as a static "→" character (no
 * pseudo-element trickery — keeps the print stylesheet honest; the
 * print ::after still exposes the real href).
 *
 * The "rev scribble" annotation on the /transactions/ link is
 * DEFERRED to v2 per spec §1.2.
 *
 * Source: about-spec-v1.md §13 + §4 type table.
 */
import fs from "node:fs";
import path from "node:path";

interface Props {
  linkedinUrl: string;
  githubUrl: string;
  transactionsUrl: string;
  resumeUrl: string;
}

const { linkedinUrl, githubUrl, transactionsUrl, resumeUrl } = Astro.props;

// Never ship a 404. The resume link only renders if the PDF is actually
// present under public/. Drop the real file at public/resume/sean-winslow.pdf
// and this link lights up on the next build.
const resumeExists =
  resumeUrl.startsWith("/") &&
  fs.existsSync(path.join(process.cwd(), "public", resumeUrl.replace(/^\//, "")));
---

<section class="proof-points" aria-labelledby="proof-points-heading">
  <!-- The "B-5 ·" frame prefix died with the 10-band anatomy (2026-08-08
       About v2 recut) — the band-naming scheme no longer exists on-page. -->
  <h2 id="proof-points-heading" class="proof-points__heading" aria-label="Proof points">
    Proof points
  </h2>
  <ul class="proof-points__list">
    <li>
      <a href={linkedinUrl} class="proof-points__link">
        <span class="proof-points__arrow" aria-hidden="true">→</span>
        <span class="proof-points__channel">LINKEDIN</span>
        <span class="proof-points__text">— Sean Winslow</span>
      </a>
    </li>
    <li>
      <a href={githubUrl} class="proof-points__link">
        <span class="proof-points__arrow" aria-hidden="true">→</span>
        <span class="proof-points__channel">GITHUB</span>
        <span class="proof-points__text">— seanwinslow28</span>
      </a>
    </li>
    <li>
      <a href={transactionsUrl} class="proof-points__link">
        <span class="proof-points__arrow" aria-hidden="true">→</span>
        <span class="proof-points__channel">TRANSACTIONS</span>
        <span class="proof-points__text">— the ledger, every artifact dated</span>
      </a>
    </li>
    {resumeExists && (
      <li>
        <a href={resumeUrl} class="proof-points__link">
          <span class="proof-points__arrow" aria-hidden="true">→</span>
          <span class="proof-points__channel">RESUME</span>
          {/* row copy says what the file IS — the shipped v3 export runs two
              pages, so "one page" would be a lie the reader can falsify in
              one click */}
          <span class="proof-points__text">— two pages, pdf</span>
        </a>
      </li>
    )}
  </ul>
</section>

<style>
  .proof-points {
    max-width: 680px;
    /* Top rhythm owned here since the About v2 recut (2026-08-08): the band
     * wrappers died, and the scoped margin would out-cascade about.css.
     * Layout pass: matches the cutaway's top gap — one "movement gap" value
     * bracketing the plate; the close below stays tight. */
    margin: clamp(72px, 10vh, 96px) auto 0;
    padding: 0 24px;
  }

  .proof-points__heading {
    margin: 0 0 32px 0;
    font-family: var(--font-serif);
    font-size: 48px;
    font-weight: 400;
    letter-spacing: -0.2px;
    line-height: 1.1;
    color: var(--teal);
    /* Centered 2026-08-08 (Sean's round 2); the link rows stay left-set. */
    text-align: center;
  }

  .proof-points__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .proof-points__list li {
    margin: 0 0 12px 0;
  }

  .proof-points__link {
    display: inline-flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.6px;
    color: var(--teal);
    text-decoration: none;
    transition: text-decoration-color 200ms;
  }

  .proof-points__link:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .proof-points__arrow {
    display: inline-block;
    width: 12px;
  }

  .proof-points__channel {
    letter-spacing: 1.2px;
  }

  .proof-points__text {
    font-weight: 400;
    color: var(--ink-secondary);
    letter-spacing: 0.4px;
  }

  @media (max-width: 767px) {
    .proof-points {
      margin-top: 60px;
      padding: 0 20px;
    }
    .proof-points__heading {
      font-size: 36px;
      margin-bottom: 24px;
    }
    .proof-points__link {
      font-size: 13px;
    }
  }

  @media print {
    .proof-points__link::after {
      content: " (" attr(href) ")";
      font-weight: 400;
      color: var(--ink-secondary);
    }
  }
</style>
