---
/**
 * Hero dateline strip. The BOSTON stamp carries the build date; the body is
 * a fixed line that makes no dated claim. The daily fleet pulse that used to
 * feed this strip was retired on 2026-10-04.
 */
import { BUILD_DATE_PRETTY } from "~/lib/dateline";

const body = "notes, builds and essays from an ai product manager.";
---

<div class="dateline-strip">
  <p class="dateline-line">
    <span class="stamp"><span class="seal">BOSTON</span>, {BUILD_DATE_PRETTY} —</span>
    <span class="body">{body}</span>
  </p>
  <hr class="dateline-rule" />
</div>

<style>
  .dateline-strip {
    margin-bottom: 30px;
  }
  .dateline-line {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 1.2px;
    line-height: 1.4;
    color: var(--ink-secondary);
    margin-bottom: 30px;
  }
  .stamp {
    color: var(--stamp-amber);
    font-weight: 500;
    margin-right: 4px;
  }
  /* Rubber-stamp city seal (2026-06-10 audit lever 2, Sean-approved V2):
     BOSTON alone gets the literal stamp — 1px amber frame, slight tilt,
     paper-fiber mask for pressed-ink texture. Home hero only; the date
     stays level on the wire line. Static, so reduced-motion-safe. */
  .seal {
    display: inline-block;
    border: 1px solid var(--stamp-amber);
    padding: 1px 5px 0;
    margin-right: 3px;
    transform: rotate(-2deg);
    transform-origin: center;
    -webkit-mask-image: url("/assets/textures/paper-tile.png");
    mask-image: url("/assets/textures/paper-tile.png");
    -webkit-mask-size: 180px 180px;
    mask-size: 180px 180px;
  }
  .dateline-rule {
    height: 0;
    border: 0;
    border-top: 0.5px solid var(--border-paper);
    margin: 0;
  }
  @media (max-width: 768px) {
    .dateline-line {
      font-size: 11px;
    }
  }
</style>
