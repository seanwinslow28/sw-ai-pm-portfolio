---
/**
 * <ExplainerGraphic /> — the "what this does at a glance" figure on a case
 * study, between the 4Q and Methods bands (critique W3). Renders only when
 * the project's frontmatter carries an `explainer:` block.
 *
 * When `explainer.interactive` names a known interactive variant, the static
 * <img> is swapped for the matching component (registry below, 2026-06-20). The
 * static `src` stays in frontmatter as the alt-text source and the ultimate
 * fallback — an unknown/typo'd `interactive:` value degrades to the <img>, never
 * a build error. Add a new explainer by importing it and adding one map entry.
 */
import AnimationPipelineExplainer from "./AnimationPipelineExplainer.astro";
import IntentExplainer from "./IntentExplainer.astro";
import CodeBrainExplainer from "./CodeBrainExplainer.astro";
import TheBlockExplainer from "./TheBlockExplainer.astro";

const INTERACTIVE = {
  "animation-pipeline": AnimationPipelineExplainer,
  "intent-engineering-mcp": IntentExplainer,
  "code-brain": CodeBrainExplainer,
  "the-block": TheBlockExplainer,
} as const;

interface Props {
  explainer: { src: string; alt: string; caption?: string; interactive?: string };
}
const { explainer } = Astro.props;
const Interactive = explainer.interactive
  ? (INTERACTIVE[explainer.interactive as keyof typeof INTERACTIVE] ?? null)
  : null;
---

<figure class="explainer-graphic">
  {Interactive ? (
    <Interactive src={explainer.src} alt={explainer.alt} />
  ) : (
    <img src={explainer.src} alt={explainer.alt} loading="lazy" decoding="async" />
  )}
  {explainer.caption && <figcaption>{explainer.caption}</figcaption>}
</figure>

<style>
  .explainer-graphic {
    /* Media spine (--cs-measure-media = 928px container − 48px gutters = ~880px
       rendered figure), so the graphic sits a touch wider than the ~672px read
       column but stays on the same centered axis as the hero (critique
       follow-up + 2026-06-19 centered-spine pass). */
    max-width: var(--cs-measure-media);
    margin: 56px auto 0;
    padding: 0 24px;
  }
  .explainer-graphic img {
    display: block;
    width: 100%;
    height: auto;
    /* Canonical 16:9 for all explainer graphics — reserves height before the
       image loads so the band doesn't shift between the 4Q and Methods bands
       (CLS). All 5 assets are authored at 16:9 (critique W3). */
    aspect-ratio: 16 / 9;
    border-radius: 4px;
  }
  .explainer-graphic figcaption {
    margin: 12px 0 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.6px;
    color: var(--ink-secondary);
    text-transform: uppercase;
    /* Centered under the graphic — a lone one-line caption reads as composed,
     * not stranded at the left of the wide figure (2026-06-19, Sean). */
    text-align: center;
  }
  @media (max-width: 767px) {
    .explainer-graphic { padding: 0 16px; margin-top: 40px; }
  }
</style>
