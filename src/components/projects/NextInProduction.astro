---
/**
 * 6th-tile "next in production" card.
 * Source: projects-spec §4.
 *
 * Mirrors ProjectTile anatomy — media area (top) + solid caption band (bottom) —
 * so the sixth cell reads as a reserved slot still on the drawing board, not
 * an empty hole. The media area carries faint pencil construction marks
 * (peg-bar registration + crop ticks) instead of a finished illustration;
 * the dashed outer border (vs the tiles' solid hairline) signals "not yet
 * drawn." The caption band carries the A-6 frame + a pulsing COMING pill.
 *
 * The `check back ~<date>` subtitle (fed by next-piece.json date_target) was
 * removed 2026-06-11 per Sean: a passed date inverts the honesty layer into
 * evidence of abandonment (audit P3-17), and the COMING pill already carries
 * the promise without naming a day. next-piece.json is no longer consumed here.
 */
import StatusPill from "./StatusPill.astro";
---

<div class="next-in-production">
  <div class="tile-media" aria-hidden="true">
    <svg class="construction" viewBox="0 0 200 250" preserveAspectRatio="xMidYMid meet">
      <!-- crop ticks -->
      <path d="M16 28 V16 H28 M172 16 H184 V28 M184 222 V234 H172 M28 234 H16 V222" />
      <!-- peg-bar registration mark, centered -->
      <circle cx="100" cy="125" r="14" />
      <path d="M100 103 V147 M78 125 H122" />
    </svg>
  </div>
  <div class="tile-meta">
    <div class="tile-meta-top">
      <span class="frame">A-6</span>
      <StatusPill status="COMING" />
    </div>
    <h3 class="title">next piece in production</h3>
  </div>
</div>

<style>
  .next-in-production {
    position: relative;
    aspect-ratio: 4 / 5;
    width: 100%;
    overflow: hidden;
    /* dashed (vs the tiles' solid hairline) = on the drawing board, not shipped */
    border: 1.5px dashed rgba(255, 249, 240, 0.4);
    background: transparent;
    transition: border-color 200ms var(--ease-out);
  }
  .next-in-production:hover {
    border-color: rgba(255, 249, 240, 0.85);
  }
  .tile-media {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .construction {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: rgba(255, 249, 240, 0.14);
    stroke-width: 1;
  }
  .tile-meta {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 14px 20px 18px;
    background-color: var(--teal-deep);
    border-top: 0.5px solid rgba(255, 249, 240, 0.14);
    box-shadow: 0 -6px 14px rgba(12, 45, 47, 0.35);
  }
  .tile-meta-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }
  .frame {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 1.4px;
    color: var(--amber-mid);
  }
  .title {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 400;
    line-height: 1.2;
    color: var(--paper);
    margin: 4px 0 2px;
  }
</style>
