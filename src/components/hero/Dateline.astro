---
/**
 * Hero dateline strip — reads /api/dateline.json at build time and renders the
 * fleet_pulse / ship_log / reading_log / now_line / ledger_row pattern.
 * Source: hero-spec §8.
 */
import datelineData from "../../../public/api/dateline.json";
import { BUILD_DATE_PRETTY, isFresh } from "~/lib/dateline";

// Date derives from the build date for cross-page coherence; the fleet
// JSON supplies the body narrative. See src/lib/dateline.ts.
//
// Gate the body with isFresh(): the date stamp is always today's, so a
// lagged fleet JSON would otherwise label yesterday's pulse with today's
// date. When the JSON isn't fresh, fall back to an evergreen line that
// makes no dated claim, keeping the load-bearing "real and dated" strip
// honest on a deploy where the fleet hasn't run yet.
const body = isFresh(datelineData.date_iso)
  ? datelineData.body
  : "morning fleet pulse posts after the 08:45 et run.";
---

<div class="dateline-strip">
  <p class="dateline-line">
    <span class="stamp"><span class="seal">BOSTON</span>, {BUILD_DATE_PRETTY} —</span>
    <span class="body">{body}</span>
  </p>
  <hr class="dateline-rule" />
</div>

<style>
  .dateline-strip {
    margin-bottom: 30px;
  }
  .dateline-line {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 1.2px;
    line-height: 1.4;
    color: var(--ink-secondary);
    margin-bottom: 30px;
  }
  .stamp {
    color: var(--stamp-amber);
    font-weight: 500;
    margin-right: 4px;
  }
  /* Rubber-stamp city seal (2026-06-10 audit lever 2, Sean-approved V2):
     BOSTON alone gets the literal stamp — 1px amber frame, slight tilt,
     paper-fiber mask for pressed-ink texture. Home hero only; the date
     stays level on the wire line. Static, so reduced-motion-safe. */
  .seal {
    display: inline-block;
    border: 1px solid var(--stamp-amber);
    padding: 1px 5px 0;
    margin-right: 3px;
    transform: rotate(-2deg);
    transform-origin: center;
    -webkit-mask-image: url("/assets/textures/paper-tile.png");
    mask-image: url("/assets/textures/paper-tile.png");
    -webkit-mask-size: 180px 180px;
    mask-size: 180px 180px;
  }
  .dateline-rule {
    height: 0;
    border: 0;
    border-top: 0.5px solid var(--border-paper);
    margin: 0;
  }
  @media (max-width: 768px) {
    .dateline-line {
      font-size: 11px;
    }
  }
</style>
