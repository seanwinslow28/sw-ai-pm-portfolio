---
/**
 * <PullQuote /> — closing pull quote.
 *
 * Echoes the home About-teaser hook byte-identical: the visitor's
 * last beat on /about/ is a callback to the line that pulled them
 * in. The lockstep contract MIGRATED from hero↔PullQuote to
 * teaser↔PullQuote per the 2026-08-06 partner-session sidecar L6
 * (the hero is a statement hero now; the hook lives on the teaser).
 *
 * The old contract was comment-only and drifted once (the D8
 * hero edit missed this echo — audit 2026-06-10), so the string
 * is now the shared ABOUT_HOOK constant in src/lib/site.ts,
 * imported by both AboutTeaser.astro and this component.
 * Byte-identical by construction; change it there or not at all.
 *
 * Per about-spec §1.2: this is also where the v1 page closes
 * (no signature SVG, no registration mark — both deferred to
 * v2). The torn-paper edge into the chrome footer follows.
 *
 * Source: about-spec-v1.md §2 anatomy + §7.2 + §1.2 + §4
 * type table (pull-quote row); sidecar L6.
 */
import { ABOUT_HOOK } from "~/lib/site";
---

<section class="pull-quote" aria-label="Closing pull quote">
  <blockquote class="pull-quote__body">
    "{ABOUT_HOOK}"
  </blockquote>
</section>

<style>
  .pull-quote {
    max-width: 880px;
    /* Vertical rhythm owned here since the About v2 recut (2026-08-08).
     * Layout pass: pulled tight against ProofPoints so links → quote read
     * as one closing beat; the bottom hands off to the footer tear. */
    margin: clamp(48px, 7vh, 64px) auto clamp(64px, 9vh, 88px);
    padding: 40px 24px;
    background-color: rgba(10, 62, 66, 0.04);
    border-top: 0.5px solid var(--border-paper);
    border-bottom: 0.5px solid var(--border-paper);
    text-align: center;
  }

  .pull-quote__body {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(28px, 4.5vw, 40px);
    font-weight: 300;
    font-style: italic;
    letter-spacing: -0.3px;
    line-height: 1.3;
    color: var(--teal);
  }

  @media (max-width: 767px) {
    .pull-quote {
      margin: 48px auto 56px;
      padding: 32px 20px;
    }
    .pull-quote__body {
      font-size: clamp(24px, 5vw, 32px);
    }
  }
</style>
