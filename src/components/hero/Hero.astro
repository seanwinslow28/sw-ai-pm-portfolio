---
/**
 * Hero — composition wrapper. Layouts the dateline, name, statement,
 * and the absolute-positioned character lane.
 *
 * Statement hero per the 2026-08-06 sidecar L6: the tagline and the
 * "/ AI PRODUCT MANAGER" tag are superseded (recorded in CHANGELOG +
 * PMP §4); under the name sits the plain statement. The dateline strip
 * and the character animation are the screen-one differentiators — any
 * "simplification" that trims them is the template trap.
 * Source: hero-spec §2-§6 + sidecar L6.
 */
import Dateline from "./Dateline.astro";
import CharacterLane from "./CharacterLane.astro";
import { HERO_STATEMENT } from "~/lib/site";

const NAME = "Sean Winslow";
---

<section class="hero page-sheet">
  <div class="hero-inner">
    <Dateline />
    <h1 class="hero-name">{NAME}</h1>
    <p class="hero-role">{HERO_STATEMENT}</p>
  </div>
  <CharacterLane />
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    /* 2026-08-08 rebalance: 880px was headroom for the two-line tagline the
     * statement hero removed; the shorter box + the name riding lower turn
     * the leftover void into a deliberate diagonal (dateline → name →
     * character). The character lane anchors bottom-right and rides the
     * shorter box automatically. */
    min-height: clamp(680px, 82vh, 780px);
    padding: 60px 52px 96px;
  }
  .hero-inner {
    position: relative;
    z-index: 20;
    max-width: 1120px;
    margin: 0 auto;
  }
  .hero-name {
    font-family: var(--font-serif);
    font-size: clamp(56px, 7.2vw, 130px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.8px;
    color: var(--teal);
    /* Pull the name block down into the character's vertical band
     * (asymmetric composition) instead of stacking void beneath it. */
    margin: clamp(16px, 5vh, 56px) 0 0;
    /* Stagger entrance */
    opacity: 0;
    animation: heroNameIn 600ms var(--ease-out) 400ms forwards;
  }
  .hero-role {
    /* D8 2026-05-30: enlarged so the role reads immediately on the 5s scan.
     * 2026-08-08 (sidecar L6): now the plain statement — no "/" prefix, no
     * forced uppercase. Mono treatment + entrance timing kept.
     * 2026-08-08 layout pass: promoted a full hierarchy level (Sean: "too
     * small") — larger clamp, teal, tracking eased as size grew. Ratio to
     * the name ~4.8:1, clearly subordinate but legible on the scan. */
    font-family: var(--font-mono);
    font-size: clamp(19px, 2vw, 27px);
    font-weight: 500;
    letter-spacing: 1.2px;
    line-height: 1.4;
    color: var(--teal);
    margin-top: 18px;
    opacity: 0;
    transform: translateY(8px);
    animation: heroRoleIn 300ms var(--ease-out) 700ms forwards;
  }

  @keyframes heroNameIn {
    to {
      opacity: 1;
    }
  }
  @keyframes heroRoleIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 600px;
      padding: 40px 24px 80px;
    }
    .hero-name {
      font-size: 56px;
      margin-top: 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-name,
    .hero-role {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
