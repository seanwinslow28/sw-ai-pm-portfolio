---
/**
 * <LoomPoster /> — optional editorial Loom video embed.
 *
 * Renders only when loomUrl is present. The poster is the <summary> of a
 * native <details> element; clicking it reveals the Loom iframe INLINE,
 * directly beneath the poster. No modal, no overlay, no JS — per the
 * system's no-modal rule (DESIGN.md §5). Strict 1-Loom max per row
 * (transactions-spec §19 OPEN-5 RESOLVED).
 *
 * Per transactions-spec §9.1 step 6 + §16 (a11y).
 */
interface Props {
  loomUrl: string;
  posterUrl?: string;             // optional editorial poster image
  title: string;                  // for the aria-label + iframe title
}
const { loomUrl, posterUrl, title } = Astro.props;

// Convert https://www.loom.com/share/<id> to https://www.loom.com/embed/<id>
function toEmbedUrl(url: string): string {
  return url.replace("/share/", "/embed/");
}
const embedUrl = toEmbedUrl(loomUrl);
---

<details class="loom-section">
  <summary class="loom-trigger" aria-label={`Play Loom video: ${title}`}>
    {posterUrl
      ? <img src={posterUrl} alt="" class="loom-poster" loading="lazy" />
      : <span class="loom-poster-fallback" aria-hidden="true">▶ Loom</span>
    }
    <span class="loom-play" aria-hidden="true">▶</span>
  </summary>

  <div class="loom-reveal">
    <iframe
      src={embedUrl}
      allow="fullscreen"
      allowfullscreen
      class="loom-iframe"
      title={`Loom video: ${title}`}
      loading="lazy"
    ></iframe>
  </div>
</details>

<style>
  .loom-section {
    max-width: 880px;
    margin: 64px auto 0;
    padding: 0 24px;
  }
  .loom-trigger {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--ink);
    border: 0.5px solid var(--border-paper);
    cursor: pointer;
    overflow: hidden;
    list-style: none;            /* hide the default disclosure triangle */
    transition: opacity 160ms var(--ease-out);
  }
  .loom-trigger::-webkit-details-marker { display: none; }
  .loom-trigger:hover { opacity: 0.92; }
  .loom-trigger:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 4px;
  }
  /* Once open, the poster collapses and the iframe takes over inline. */
  .loom-section[open] .loom-trigger { display: none; }

  .loom-poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .loom-poster-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 18px;
    letter-spacing: 1.2px;
  }
  .loom-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--paper);
    font-size: 48px;
    pointer-events: none;
    text-shadow: 0 2px 8px rgba(10, 62, 66, 0.4);
  }

  .loom-reveal {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0.5px solid var(--border-paper);
  }
  .loom-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  @media (max-width: 767px) {
    .loom-section { padding: 0 16px; margin-top: 48px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .loom-trigger { transition: none; }
  }
</style>
